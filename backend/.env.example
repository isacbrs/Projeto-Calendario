# Exemplo de configuração das variáveis de ambiente.
# Faça uma cópia deste arquivo, renomeie para ".env" e preencha com seus dados. Não suba o .env para o GitHub!

# Credenciais do Supabase (O responsável pelo Banco de Dados deve preencher com as chaves de produção/teste)
SUPABASE_URL=cole_a_url_aqui
SUPABASE_KEY=cole_a_key_aqui

# Chaves de Segurança da API (Cada desenvolvedor deve gerar as suas para rodar localmente)
# Para gerar uma chave segura, rode no terminal: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=gere_sua_chave_e_cole_aqui
JWT_REFRESH_SECRET=gere_outra_chave_e_cole_aqui